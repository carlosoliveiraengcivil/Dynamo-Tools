  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "Autodesk.AutoCAD.DynamoNodes.ObjectSelection, AutoCADNodesUI",
      "NodeType": "ExtensionNode",
      "InstanceId": [
        "1DDA2"
      ],
      "Id": "a164edcdbbd044c5b9ade13740ca194e",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "9530b42bd8ca426fb6c131bcec7e41dd",
          "Name": "Object",
          "Description": "Object",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Select an object in the current document"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CIVIL 3D NEXUS - AUTOMATION\r\n# TOOL 02: Smart Extractor V9 (Cross-Section & Skeletonization)\r\n\r\nimport sys\r\nimport clr\r\nimport math\r\n\r\nclr.AddReference('acmgd')\r\nclr.AddReference('acdbmgd')\r\nclr.AddReference('AeccDbMgd')\r\n\r\nfrom Autodesk.AutoCAD.ApplicationServices import *\r\nfrom Autodesk.AutoCAD.DatabaseServices import *\r\nfrom Autodesk.AutoCAD.Geometry import *\r\nfrom Autodesk.Civil.DatabaseServices import *\r\nfrom Autodesk.AutoCAD.Colors import Color, ColorMethod\r\n\r\n# -------------------------------------------------------------\r\n# INPUTS\r\n# -------------------------------------------------------------\r\nsurf_input = IN[0]\r\npoly_input = IN[1]\r\n\r\ntry: step_dist = float(IN[2])\r\nexcept: step_dist = 2.0\r\n\r\ntry: sweep_width = float(IN[3])\r\nexcept: sweep_width = 40.0\r\n\r\ntry: slope_cut = float(IN[4])\r\nexcept: slope_cut = 25.0\r\n\r\ntry: merge_tol = float(IN[5])\r\nexcept: merge_tol = 0.8\r\n\r\ntry: smooth_tol = float(IN[6])\r\nexcept: smooth_tol = 1.5\r\n\r\nbake_mode = bool(IN[7])\r\n\r\n# INTERNAL PARAMS\r\nSAMPLE_RES = 0.5 # A cada 0.5m na costela, ele lê o Z do terreno\r\n\r\n# NOVO: Garante um raio de busca mínimo de 8 metros para pular falhas da malha\r\nSTITCH_MAX_DIST = max(step_dist * 3.0, 7.0)\r\n\r\nadoc = Application.DocumentManager.MdiActiveDocument\r\ndb = adoc.Database\r\n\r\n# -------------------------------------------------------------\r\n# FUNÇÕES DE GEOMETRIA\r\n# -------------------------------------------------------------\r\ndef get_elevation(surf, x, y):\r\n    try:\r\n        return surf.FindElevationAtXY(x, y)\r\n    except:\r\n        return None\r\n\r\ndef simplify_polyline(points, epsilon):\r\n    if len(points) < 3 or epsilon <= 0.001: return points\r\n    def pt_line_dist(pt, start, end):\r\n        x0, y0 = pt[0], pt[1]\r\n        x1, y1 = start[0], start[1]\r\n        x2, y2 = end[0], end[1]\r\n        num = abs((y2 - y1)*x0 - (x2 - x1)*y0 + x2*y1 - y2*x1)\r\n        den = math.sqrt((y2 - y1)**2 + (x2 - x1)**2)\r\n        if den == 0: return math.sqrt((x0 - x1)**2 + (y0 - y1)**2)\r\n        return num / den\r\n\r\n    stack = [(0, len(points) - 1)]\r\n    keep = [False] * len(points)\r\n    keep[0], keep[-1] = True, True\r\n    while stack:\r\n        start, end = stack.pop()\r\n        dmax = 0.0\r\n        index = start\r\n        for i in range(start + 1, end):\r\n            d = pt_line_dist(points[i], points[start], points[end])\r\n            if d > dmax:\r\n                index, dmax = i, d\r\n        if dmax >= epsilon:\r\n            keep[index] = True\r\n            stack.append((start, index))\r\n            stack.append((index, end))\r\n    return [points[i] for i in range(len(points)) if keep[i]]\r\n\r\n# -------------------------------------------------------------\r\n# MOTOR PRINCIPAL\r\n# -------------------------------------------------------------\r\ndoclock = adoc.LockDocument()\r\nt = db.TransactionManager.StartTransaction()\r\n\r\ntry:\r\n    if not hasattr(surf_input, 'InternalObjectId'):\r\n        raise ValueError(\"Selecione a Superfície!\")\r\n    if not hasattr(poly_input, 'InternalObjectId'):\r\n        raise ValueError(\"Selecione a Linha Guia!\")\r\n        \r\n    tinsurf = t.GetObject(surf_input.InternalObjectId, OpenMode.ForRead)\r\n    guide_curve = t.GetObject(poly_input.InternalObjectId, OpenMode.ForRead)\r\n    \r\n    total_len = guide_curve.Length\r\n    num_steps = int(total_len / step_dist)\r\n    \r\n    all_crests = []\r\n    all_toes = []\r\n    \r\n    # 1. FATIAMENTO (Criando as Costelas)\r\n    for i in range(num_steps + 1):\r\n        dist = min(i * step_dist, total_len)\r\n        pt_on_curve = guide_curve.GetPointAtDist(dist)\r\n        deriv = guide_curve.GetFirstDerivative(pt_on_curve)\r\n        \r\n        # Vetor Perpendicular 2D (Rotaciona 90 graus)\r\n        normal = Vector2d(-deriv.Y, deriv.X).GetNormal()\r\n        \r\n        # Cria a linha de seção (costela)\r\n        section_pts = []\r\n        half_sweep = sweep_width / 2.0\r\n        \r\n        # Varre da esquerda para a direita ao longo da normal\r\n        samples = int(sweep_width / SAMPLE_RES)\r\n        for s in range(samples + 1):\r\n            offset = -half_sweep + (s * SAMPLE_RES)\r\n            px = pt_on_curve.X + (normal.X * offset)\r\n            py = pt_on_curve.Y + (normal.Y * offset)\r\n            pz = get_elevation(tinsurf, px, py)\r\n            \r\n            if pz is not None:\r\n                section_pts.append((px, py, pz, offset))\r\n                \r\n# 2. ANÁLISE DO PERFIL 2D E FILTRO ANTI-RUÍDO\r\n        sect_crests = []\r\n        sect_toes = []\r\n        \r\n        if len(section_pts) > 4:\r\n            # --- NOVO: FILTRO DE MÉDIA MÓVEL (Amortecedor de pedras/ruídos) ---\r\n            # Suaviza a fatia 2D antes de calcular a declividade\r\n            smoothed_pts = []\r\n            for s in range(len(section_pts)):\r\n                start_idx = max(0, s - 1)\r\n                end_idx = min(len(section_pts) - 1, s + 1)\r\n                # Tira a média do Z com o vizinho da frente e de trás\r\n                avg_z = sum(section_pts[k][2] for k in range(start_idx, end_idx + 1)) / (end_idx - start_idx + 1)\r\n                smoothed_pts.append((section_pts[s][0], section_pts[s][1], avg_z, section_pts[s][3]))\r\n            \r\n            section_pts = smoothed_pts # Substitui a fatia ruidosa pela fatia suave\r\n            # ------------------------------------------------------------------\r\n\r\n            states = [] # False = Flat, True = Steep\r\n            # Calcula as inclinações dos segmentos da costela\r\n            for j in range(len(section_pts)-1):\r\n                p1 = section_pts[j]\r\n                p2 = section_pts[j+1]\r\n                dz = p2[2] - p1[2]\r\n                dx = p2[3] - p1[3]\r\n                slope = abs(dz / dx) * 100.0 if dx != 0 else 0\r\n                states.append((slope >= slope_cut, p1, p2, dz))\r\n                \r\n            # Identifica as quebras\r\n            for j in range(len(states)-1):\r\n                s1, s2 = states[j], states[j+1]\r\n                steep1, ptA, ptB, dz1 = s1\r\n                steep2, ptC, ptD, dz2 = s2\r\n                \r\n                if steep1 != steep2:\r\n                    mid_pt = ptB # Ponto de articulação\r\n                    \r\n                    # Flat -> Steep (Começou a cair/subir)\r\n                    if not steep1 and steep2:\r\n                        if dz2 < 0: sect_crests.append(mid_pt) # Caiu = Crista\r\n                        else: sect_toes.append(mid_pt)         # Subiu = Pé\r\n                    \r\n                    # Steep -> Flat (Parou de cair/subir)\r\n                    elif steep1 and not steep2:\r\n                        if dz1 < 0: sect_toes.append(mid_pt)   # Parou de cair = Pé\r\n                        else: sect_crests.append(mid_pt)       # Parou de subir = Crista\r\n\r\n        # 3. A SUA MÁGICA: MERGE DE LEIRAS (O Bico)\r\n        def merge_close_points(pts, tol):\r\n            if not pts: return []\r\n            merged = []\r\n            curr_group = [pts[0]]\r\n            for j in range(1, len(pts)):\r\n                p_prev = pts[j-1]\r\n                p_curr = pts[j]\r\n                dist_2d = abs(p_curr[3] - p_prev[3]) # Distância ao longo da costela\r\n                if dist_2d <= tol:\r\n                    curr_group.append(p_curr)\r\n                else:\r\n                    # Tira a média XYZ do grupo\r\n                    mx = sum(p[0] for p in curr_group) / len(curr_group)\r\n                    my = sum(p[1] for p in curr_group) / len(curr_group)\r\n                    mz = sum(p[2] for p in curr_group) / len(curr_group)\r\n                    moff = sum(p[3] for p in curr_group) / len(curr_group)\r\n                    merged.append((mx, my, mz, moff))\r\n                    curr_group = [p_curr]\r\n            \r\n            # Adiciona o último grupo\r\n            if curr_group:\r\n                mx = sum(p[0] for p in curr_group) / len(curr_group)\r\n                my = sum(p[1] for p in curr_group) / len(curr_group)\r\n                mz = sum(p[2] for p in curr_group) / len(curr_group)\r\n                moff = sum(p[3] for p in curr_group) / len(curr_group)\r\n                merged.append((mx, my, mz, moff))\r\n            return merged\r\n\r\n        sect_crests = merge_close_points(sect_crests, merge_tol)\r\n        sect_toes = merge_close_points(sect_toes, merge_tol)\r\n        \r\n        all_crests.append(sect_crests)\r\n        all_toes.append(sect_toes)\r\n\r\n    # 4. A COSTURA 3D (Ligando as fatias)\r\n    def stitch_sections(sections_data):\r\n        lines = []\r\n        if not sections_data: return lines\r\n        \r\n        # Inicia as linhas com os pontos da primeira fatia válida\r\n        active_lines = []\r\n        for sect in sections_data:\r\n            if sect:\r\n                active_lines = [[p] for p in sect]\r\n                break\r\n                \r\n        for i in range(1, len(sections_data)):\r\n            current_pts = sections_data[i]\r\n            if not current_pts: continue\r\n            \r\n            used_pts = set()\r\n            for al in active_lines:\r\n                last_pt = al[-1]\r\n                best_match = None\r\n                best_dist = STITCH_MAX_DIST\r\n                \r\n                for idx, cp in enumerate(current_pts):\r\n                    if idx in used_pts: continue\r\n                    dist_3d = math.sqrt((last_pt[0]-cp[0])**2 + (last_pt[1]-cp[1])**2 + (last_pt[2]-cp[2])**2)\r\n                    \r\n                    if dist_3d < best_dist:\r\n                        best_dist = dist_3d\r\n                        best_match = idx\r\n                        \r\n                if best_match is not None:\r\n                    al.append(current_pts[best_match])\r\n                    used_pts.add(best_match)\r\n            \r\n            # Se sobrou ponto novo na fatia, começa uma linha nova\r\n            for idx, cp in enumerate(current_pts):\r\n                if idx not in used_pts:\r\n                    active_lines.append([cp])\r\n                    \r\n        return [line for line in active_lines if len(line) > 2] # Remove pontinhos isolados\r\n\r\n    final_crests = stitch_sections(all_crests)\r\n    final_toes = stitch_sections(all_toes)\r\n    \r\n    # 5. SUAVIZAÇÃO E DESENHO\r\n    final_crests = [simplify_polyline(p, smooth_tol) for p in final_crests]\r\n    final_toes = [simplify_polyline(p, smooth_tol) for p in final_toes]\r\n\r\n    layer_crista = \"TOPO-CRISTA\" if bake_mode else \"_TEMP_CRISTA\"\r\n    layer_pe = \"TOPO-PE\" if bake_mode else \"_TEMP_PE\"\r\n    \r\n    lt = t.GetObject(db.LayerTableId, OpenMode.ForWrite)\r\n    for l_name, l_color in [(layer_crista, 1), (layer_pe, 3)]:\r\n        if not lt.Has(l_name):\r\n            new_layer = LayerTableRecord()\r\n            new_layer.Name = l_name\r\n            new_layer.Color = Color.FromColorIndex(ColorMethod.ByAci, l_color)\r\n            lt.Add(new_layer)\r\n            t.AddNewlyCreatedDBObject(new_layer, True)\r\n\r\n    msId = SymbolUtilityServices.GetBlockModelSpaceId(db)\r\n    ms = t.GetObject(msId, OpenMode.ForWrite)\r\n\r\n    for obj_id in ms:\r\n        ent = t.GetObject(obj_id, OpenMode.ForWrite)\r\n        if ent.Layer == \"_TEMP_CRISTA\" or ent.Layer == \"_TEMP_PE\":\r\n            ent.Erase()\r\n\r\n    linhas_c = 0\r\n    linhas_p = 0\r\n    for poly_list, target_layer in [(final_crests, layer_crista), (final_toes, layer_pe)]:\r\n        for p_pts in poly_list:\r\n            if len(p_pts) < 2: continue\r\n            pts3d = Point3dCollection()\r\n            for p in p_pts: pts3d.Add(Point3d(p[0], p[1], p[2]))\r\n            poly3d = Polyline3d(Poly3dType.SimplePoly, pts3d, False)\r\n            poly3d.Layer = target_layer\r\n            ms.AppendEntity(poly3d)\r\n            t.AddNewlyCreatedDBObject(poly3d, True)\r\n            if target_layer == layer_crista: linhas_c += 1\r\n            else: linhas_p += 1\r\n\r\n    t.Commit()\r\n    \r\n    OUT = \"### NEXUS V9: FATIADOR GUIADO ###\\n\\n\"\r\n    OUT += \"Fatias Processadas: {}\\n\".format(num_steps)\r\n    OUT += \"Modo: {}\\n\".format(\"DEFINITIVO\" if bake_mode else \"RASCUNHO\")\r\n    OUT += \"\\n-> CRISTAS EXTRAÍDAS: {}\\n\".format(linhas_c)\r\n    OUT += \"-> PÉS EXTRAÍDOS: {}\\n\".format(linhas_p)\r\n\r\nexcept Exception as ex:\r\n    if 't' in locals(): t.Abort()\r\n    import traceback\r\n    OUT = \"ERRO:\\n\" + traceback.format_exc()\r\nfinally:\r\n    if 't' in locals(): t.Dispose()\r\n    doclock.Dispose()",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "03ed0de956b047c992456b460a570f63",
      "NodeType": "PythonScriptNode",
