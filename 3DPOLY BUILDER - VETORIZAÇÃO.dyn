    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "8ecb741b289443b79d3b6f607a23975a",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "c1895af72e6f4857b0d3967ea8cce2de",
          "Name": "object",
          "Description": "Autodesk.AutoCAD.DynamoNodes.Object",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "65864f39ebe7419a936c9d5fb7256a8a",
          "Name": "string",
          "Description": "Name of layer",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "Autodesk.AutoCAD.DynamoNodes.Object.Layer",
      "Replication": "Auto",
      "Description": "Returns the layer name of an object\n\nObject.Layer: string"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport sys\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import Point, Vector\r\n\r\n# ==========================================\r\n# 1. INPUTS DA INTERFACE\r\n# ==========================================\r\nraw_pool = IN[0] if isinstance(IN[0], list) else [IN[0]]\r\nseed_section = IN[1] if isinstance(IN[1], list) else [IN[1]]\r\n\r\ndef get_centroid(pts):\r\n    if not pts: return None\r\n    return Point.ByCoordinates(sum(p.X for p in pts)/len(pts), \r\n                               sum(p.Y for p in pts)/len(pts), \r\n                               sum(p.Z for p in pts)/len(pts))\r\n\r\n# Faxina contra duplo clique do topógrafo (pontos a menos de 1cm)\r\npool = []\r\nfor p in raw_pool:\r\n    if not any(p.DistanceTo(up) < 0.01 for up in pool): pool.append(p)\r\n\r\n# Retira os pontos iniciais da piscina\r\npool = [p for p in pool if not any(p.DistanceTo(s) < 0.01 for s in seed_section)]\r\n\r\n# Trava de segurança caso a entrada venha vazia\r\nif not seed_section or not pool:\r\n    OUT = [[], []]\r\n    sys.exit()\r\n\r\n# ==========================================\r\n# 2. AUTO-CALIBRAÇÃO MACIA (Elástico)\r\n# ==========================================\r\n# Pega a largura máxima da sua seção (a rua inteira)\r\nconduit_width = max([s1.DistanceTo(s2) for s1 in seed_section for s2 in seed_section])\r\n\r\n# A BLINDAGEM DA LARGURA MÍNIMA:\r\n# Nunca deixa o conduíte ter menos de 2.5 metros de base de cálculo.\r\n# Isso impede que o \"Paredão de Borracha\" fique espremido demais se a seção inicial for pequena.\r\nif conduit_width < 2.5: \r\n    conduit_width = 2.5 \r\n\r\n# Define o vetor guia inicial\r\nseed_centroid = get_centroid(seed_section)\r\npool.sort(key=lambda p: p.DistanceTo(seed_centroid))\r\nnext_centroid = get_centroid(pool[:len(seed_section)])\r\n\r\nif seed_centroid.DistanceTo(next_centroid) > 0.1:\r\n    initial_vector = Vector.ByTwoPoints(seed_centroid, next_centroid).Normalized()\r\nelse:\r\n    initial_vector = Vector.ByCoordinates(0, 1, 0)\r\n\r\n# ==========================================\r\n# 3. RASTREADOR (Cães Adestrados)\r\n# ==========================================\r\nwires = [[s] for s in seed_section]\r\ncurrent_vectors = [initial_vector for _ in seed_section]\r\nactive_wires = [True for _ in seed_section]\r\nerror_pts = []\r\n\r\nwhile any(active_wires) and len(pool) > 0:\r\n    for i, wire in enumerate(wires):\r\n        if not active_wires[i]: continue\r\n\r\n        p_curr = wire[-1]\r\n        v_curr = current_vectors[i]\r\n        \r\n        best_p = None\r\n        best_score = float('inf')\r\n\r\n        for p_test in pool:\r\n            dist = p_curr.DistanceTo(p_test)\r\n            vec_to_test = Vector.ByTwoPoints(p_curr, p_test)\r\n            if vec_to_test.Length < 0.01: continue\r\n            \r\n            vec_to_test_norm = vec_to_test.Normalized()\r\n            \r\n            # DOT PRODUCT: 1 = Reto, 0 = 90 graus, -1 = Para trás\r\n            dot = v_curr.Dot(vec_to_test_norm)\r\n            if dot < 0.0: continue # Ignora totalmente se o ponto estiver pra trás\r\n\r\n            cross_vec = v_curr.Cross(vec_to_test)\r\n            deviation = cross_vec.Length\r\n\r\n            # ==========================================\r\n            # REGRA DO PAREDÃO DE BORRACHA:\r\n            # Multiplicador 1.15 dá margem para curvas sem pular pra outra rua.\r\n            # Como a conduit_width tem o mínimo de 2.5m, o desvio lateral\r\n            # máximo permitido será sempre de no mínimo ~2.8m.\r\n            # ==========================================\r\n            if deviation > (conduit_width * 1.4): continue\r\n\r\n            # A NOTA MAGNÉTICA (AGORA COM MULTA DE FAIXA):\r\n            # Distância pesa e curva pesa...\r\n            angle_penalty = (1.0 - dot) * (conduit_width * 3.0)\r\n            \r\n            # ... MAS O DESVIO LATERAL PESA MUITO MAIS! (Multa de 5x)\r\n            # Isso impede ele de roubar o ponto do vizinho, forçando ele a ficar na reta.\r\n            deviation_penalty = deviation * 5.0 \r\n            \r\n            score = dist + angle_penalty + deviation_penalty\r\n            # ==========================================\r\n\r\n            if score < best_score:\r\n                best_score = score\r\n                best_p = p_test\r\n\r\n        if best_p:\r\n            wire.append(best_p)\r\n            new_v = Vector.ByTwoPoints(p_curr, best_p).Normalized()\r\n            \r\n            # O cão vira o pescoço mais rápido para fazer curvas agudas sem perder o faro\r\n            smooth_v = Vector.ByCoordinates((v_curr.X + new_v.X*2)/3, \r\n                                            (v_curr.Y + new_v.Y*2)/3, \r\n                                            (v_curr.Z + new_v.Z*2)/3).Normalized()\r\n            current_vectors[i] = smooth_v\r\n            \r\n            # Remove da piscina pra ninguém mais pegar (evita o cão guloso roubar do vizinho)\r\n            pool.remove(best_p)\r\n        else:\r\n            # Se não achou ninguém (bater no paredão ou acabar a nuvem), encerra a linha\r\n            active_wires[i] = False\r\n            error_pts.append(p_curr)\r\n\r\n# Manda os fios e os pontos de alerta pro nó de desenho\r\nOUT = [wires, error_pts]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "aa5a639eeb88445aaa23838952eab6e8",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "de650c4c41c24baab1b2d3e56f40c685",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a5ea67a106b24c7fa62424d293bb27bf",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "3ddc7ae37b1d493c935c7bf84994444a",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "2b9ceabb24084f14a912640ba91f654c",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "bb150abd9e38485286b81afeb331c3ce",
          "Name": "x",
          "Description": "Basic type object to compare (e.g. bool, int, double, string, etc.)\n\nvar[]..[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "2ce62cb21878438b875eceeaeff253af",
          "Name": "y",
          "Description": "Basic type object to compare (e.g. bool, int, double, string, etc.)\n\nvar[]..[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
