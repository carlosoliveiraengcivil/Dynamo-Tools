    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('AcMgd')\r\nclr.AddReference('AcDbMgd')\r\nclr.AddReference('AcCoreMgd')\r\nclr.AddReference('ProtoGeometry')\r\n\r\nfrom Autodesk.AutoCAD.ApplicationServices import *\r\nfrom Autodesk.AutoCAD.DatabaseServices import *\r\n# OLHA O VECTOR3D AQUI:\r\nfrom Autodesk.AutoCAD.Geometry import Point3d, Point3dCollection, Vector3d\r\nfrom Autodesk.AutoCAD.Colors import Color, ColorMethod\r\nfrom Autodesk.DesignScript.Geometry import Point\r\n\r\ndata = IN[0]\r\nline_data = data[0] if data[0] else []\r\nerror_pts = data[1] if data[1] else []\r\nlayer_name = str(IN[1])\r\n\r\ndoc = Application.DocumentManager.MdiActiveDocument\r\ndb = doc.Database\r\n\r\ndef dyn_to_acad(pt):\r\n    return Point3d(pt.X, pt.Y, pt.Z)\r\n\r\nwith doc.LockDocument():\r\n    with db.TransactionManager.StartTransaction() as t:\r\n        try:\r\n            btr = t.GetObject(db.CurrentSpaceId, OpenMode.ForWrite)\r\n            lt = t.GetObject(db.LayerTableId, OpenMode.ForRead)\r\n            \r\n            # 1. Desenha as Polilinhas construídas até bater no erro\r\n            final_layer = layer_name if lt.Has(layer_name) else \"0\"\r\n            for line in line_data:\r\n                if len(line) > 1:\r\n                    ac_pts = Point3dCollection()\r\n                    for p in line: ac_pts.Add(dyn_to_acad(p))\r\n                    poly = Polyline3d(Poly3dType.SimplePoly, ac_pts, False)\r\n                    poly.Layer = final_layer\r\n                    btr.AppendEntity(poly)\r\n                    t.AddNewlyCreatedDBObject(poly, True)\r\n\r\n            # 2. Desenha o alerta no exato lugar onde o robô parou\r\n            if error_pts:\r\n                if not lt.Has(\"ERRO_AUTOMACAO\"):\r\n                    lt.UpgradeOpen()\r\n                    nltr = LayerTableRecord()\r\n                    nltr.Name = \"ERRO_AUTOMACAO\"\r\n                    nltr.Color = Color.FromColorIndex(ColorMethod.ByAci, 1)\r\n                    lt.Add(nltr)\r\n                    t.AddNewlyCreatedDBObject(nltr, True)\r\n                \r\n                for err_p in error_pts:\r\n                    circ = Circle(dyn_to_acad(err_p), Vector3d.ZAxis, 0.50)\r\n                    circ.Layer = \"ERRO_AUTOMACAO\"\r\n                    circ.ColorIndex = 1 \r\n                    btr.AppendEntity(circ)\r\n                    t.AddNewlyCreatedDBObject(circ, True)\r\n\r\n            t.Commit()\r\n            OUT = \"Polilinhas criadas! Em caso de círculos vermelhos, verifique a conformação dos pontos. Para acessar mais ferramentas Dynamo, entre em contato: https://www.linkedin.com/in/carlos-oliveira-038919259.\"\r\n        except Exception as e:\r\n            t.Abort()\r\n            OUT = \"Erro: \" + str(e)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "e0d591d347e1453ca65d18bebb005405",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "15dd02582b6741e4877e6a60266b8123",
          "Name": "IN[0]",
          "Description": "Input #0",
