    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "328105a418f140c98e3fd0523712e39f",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "5c3f439518744e9198e254d615bbefaf",
          "Name": "object",
          "Description": "Autodesk.AutoCAD.DynamoNodes.Object",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "647d5925b3e74a98beb9b02488abf916",
          "Name": "Geometry",
          "Description": "Dynamo geometry",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "Autodesk.AutoCAD.DynamoNodes.Object.Geometry",
      "Replication": "Auto",
      "Description": "Returns the Dynamo geometry representation of an object\n\nObject.Geometry: Geometry"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import sys\r\nimport clr\r\n\r\n# Bibliotecas de Geometria\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# --- ENTRADAS (IN[0] a IN[6]) ---\r\ncurvas_input = IN[0]            \r\nsomente_vertices = IN[1]        \r\nintervalo = float(IN[2])        \r\nbase_estaca = float(IN[3])      \r\nestaca_inicial = float(IN[4])   \r\nincluir_v = IN[5]               \r\ndesc_manual = IN[6]             \r\n\r\n# --- INICIALIZAÇÃO ---\r\nlinhas_txt = []\r\npontos_gerados = []\r\ndescricoes_final = []\r\n\r\n# NOVO: Rastreador de coordenadas para evitar pontos duplicados\r\ncoordenadas_vistas = set() \r\n\r\nif not isinstance(curvas_input, list):\r\n    curvas_input = [curvas_input]\r\n\r\n# O contador global para numeração contínua!\r\ncontador_pontos = 1\r\n\r\ntry:\r\n    for curva in curvas_input:\r\n        if not curva:\r\n            continue\r\n            \r\n        dist_total = curva.Length\r\n        dists = []\r\n        \r\n        # 1. LÓGICA DE DISTÂNCIAS\r\n        if somente_vertices:\r\n            dists.append(0.0)\r\n            try:\r\n                acumulado = 0.0\r\n                for s in curva.Curves():\r\n                    acumulado += s.Length\r\n                    dists.append(acumulado)\r\n            except:\r\n                dists.append(dist_total)\r\n        else:\r\n            d = 0.0\r\n            while d <= dist_total + 0.001:\r\n                dists.append(d)\r\n                d += intervalo\r\n            dists.append(dist_total)\r\n            \r\n            if incluir_v:\r\n                dists.append(0.0)\r\n                try:\r\n                    acumulado = 0.0\r\n                    for s in curva.Curves():\r\n                        acumulado += s.Length\r\n                        dists.append(acumulado)\r\n                except:\r\n                    dists.append(dist_total)\r\n        \r\n        dists_ordenadas = sorted(list(set([round(x, 4) for x in dists])))\r\n        \r\n        # 2. GERAÇÃO DE PONTOS E TEXTO\r\n        for d in dists_ordenadas:\r\n            dist_ajustada = min(d, dist_total)\r\n            pt = curva.PointAtSegmentLength(dist_ajustada)\r\n            \r\n            # --- NOVO: FILTRO DE DUPLICATAS POR COORDENADA ---\r\n            # Cria uma chave única baseada no X, Y, Z com 4 casas decimais\r\n            coord_key = (round(pt.X, 4), round(pt.Y, 4), round(pt.Z, 4))\r\n            \r\n            if coord_key in coordenadas_vistas:\r\n                continue \r\n                \r\n            coordenadas_vistas.add(coord_key) # Salva a coordenada na memória\r\n            # -------------------------------------------------\r\n            \r\n            pontos_gerados.append(pt)\r\n            \r\n            # Montagem das 4 primeiras colunas (P, N, E, Z)\r\n            colunas = [\r\n                str(contador_pontos),\r\n                \"{:.4f}\".format(pt.Y),\r\n                \"{:.4f}\".format(pt.X),\r\n                \"{:.4f}\".format(pt.Z)\r\n            ]\r\n            \r\n            # --- LÓGICA INTELIGENTE DE DESCRIÇÃO ---\r\n            texto_estaca = \"\"\r\n            if base_estaca > 0:\r\n                dist_real = dist_ajustada + estaca_inicial\r\n                inteiro = int(dist_real // base_estaca)\r\n                resto = dist_real % base_estaca\r\n                texto_estaca = \"{}+{:06.3f}\".format(inteiro, resto)\r\n            \r\n            texto_desc = \"\"\r\n            if desc_manual and str(desc_manual).strip():\r\n                texto_desc = str(desc_manual).strip()\r\n                \r\n            # Junta os dois sem usar vírgula!\r\n            partes_desc = []\r\n            if texto_desc:\r\n                partes_desc.append(texto_desc)\r\n            if texto_estaca:\r\n                partes_desc.append(texto_estaca)\r\n                \r\n            descricao_final = \" - \".join(partes_desc)\r\n            \r\n            # Se a pessoa não preencheu nada, coloca algo padrão pra não dar erro\r\n            if not descricao_final:\r\n                descricao_final = \"PNEZ\"\r\n                \r\n            # Adiciona a 5ª e última coluna\r\n            colunas.append(descricao_final)\r\n            descricoes_final.append(descricao_final)\r\n            \r\n            # Transforma tudo em linha de texto\r\n            linha_final = \",\".join(colunas)\r\n            linhas_txt.append(linha_final)\r\n            \r\n            contador_pontos += 1\r\n\r\n    status = \"Sucesso! {} pontos processados em {} linha(s).\\nPara acessar mais ferramentas Dynamo, entre em contato: https://www.linkedin.com/in/carlos-oliveira-038919259\".format(len(linhas_txt), len(curvas_input))\r\n\r\nexcept Exception as e:\r\n    status = \"Erro no processamento: \" + str(e)\r\n\r\n# --- SAÍDAS ---\r\nOUT = [linhas_txt, pontos_gerados, descricoes_final, status]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "db2fddc0af2448da8b92e8fcdad81a88",
      "NodeType": "PythonScriptNode",
      "Inputs": [
