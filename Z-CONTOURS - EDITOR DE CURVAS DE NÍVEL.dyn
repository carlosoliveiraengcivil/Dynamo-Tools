      "Id": "551a0f313cf241d096e7e6bfc36eb9d2",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "4e717e1f314349629f010df9c55e88f3",
          "Name": "Objects",
          "Description": "Objects",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Select multiple objects in the current document"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# Referências fundamentais\r\nclr.AddReference('AcDbMgd')\r\nclr.AddReference('AcMgd')\r\n\r\nfrom Autodesk.AutoCAD.DatabaseServices import *\r\nfrom Autodesk.AutoCAD.ApplicationServices import *\r\n# AQUI ESTAVA O ERRO: Precisamos importar o ColorMethod também!\r\nfrom Autodesk.AutoCAD.Colors import Color, ColorMethod \r\n\r\n# Inputs do Dynamo\r\ninput_objects = IN[0] if isinstance(IN[0], list) else [IN[0]]\r\n\r\ndoc = Application.DocumentManager.MdiActiveDocument\r\ndb = doc.Database\r\n\r\noutput = []\r\n\r\n# --- FUNÇÃO AUXILIAR CORRIGIDA ---\r\ndef set_layer_props(tr, lt, name, color_index):\r\n    if not lt.Has(name):\r\n        lt.UpgradeOpen()\r\n        nlr = LayerTableRecord()\r\n        nlr.Name = name\r\n        # Agora o ColorMethod vai ser reconhecido!\r\n        nlr.Color = Color.FromColorIndex(ColorMethod.ByAci, color_index)\r\n        lt.Add(nlr)\r\n        tr.AddNewlyCreatedDBObject(nlr, True)\r\n    else:\r\n        layer = tr.GetObject(lt[name], OpenMode.ForWrite)\r\n        layer.Color = Color.FromColorIndex(ColorMethod.ByAci, color_index)\r\n\r\n# --- EXECUÇÃO SEGURA ---\r\nlock = doc.LockDocument()\r\ntry:\r\n    with db.TransactionManager.StartTransaction() as tr:\r\n        lt = tr.GetObject(db.LayerTableId, OpenMode.ForRead)\r\n        \r\n        # Configura as camadas (Mestra e Intermediária)\r\n        set_layer_props(tr, lt, \"CURVAS_MESTRAS\", 10)\r\n        set_layer_props(tr, lt, \"CURVAS_INTERMEDIARIAS\", 34)\r\n\r\n        for dyn_obj in input_objects:\r\n            if dyn_obj is None: continue\r\n            \r\n            try:\r\n                # Tenta pegar o ID direto, se não der, vai pelo Handle\r\n                try:\r\n                    obj_id = dyn_obj.InternalObjectId\r\n                except:\r\n                    h = Handle(int(dyn_obj.Handle, 16))\r\n                    obj_id = db.GetObjectId(False, h, 0)\r\n\r\n                if obj_id.IsNull: continue\r\n\r\n                ent = tr.GetObject(obj_id, OpenMode.ForWrite)\r\n                \r\n                # Pega a elevação (Z)\r\n                elev = 0.0\r\n                if hasattr(ent, \"Elevation\"):\r\n                    elev = ent.Elevation\r\n                elif hasattr(ent, \"StartPoint\"): # Caso de linhas simples\r\n                    elev = ent.StartPoint.Z\r\n                \r\n                # Lógica: Múltiplos de 5 = Mestra\r\n                if round(elev, 2) % 5 == 0:\r\n                    ent.Layer = \"CURVAS_MESTRAS\"\r\n                else:\r\n                    ent.Layer = \"CURVAS_INTERMEDIARIAS\"\r\n                \r\n                ent.ColorIndex = 256 # ByLayer\r\n                output.append(\"Processado: \" + str(round(elev, 2)))\r\n\r\n            except Exception as e_item:\r\n                output.append(\"Erro no item: \" + str(e_item))\r\n\r\n        tr.Commit()\r\nexcept Exception as e_geral:\r\n    output.append(\"Erro Geral: \" + str(e_geral))\r\nfinally:\r\n    # Destrava o documento para evitar Fatal Error ao sair\r\n    lock.Dispose()\r\n\r\nOUT = output",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "3c187d6dbe7b45b8bf1651582b054460",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "fe55a1243e9e47a38b93e1ee2eeb573e",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "8a6493076ac8463194864623ad8c0a84",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    }
  ],
