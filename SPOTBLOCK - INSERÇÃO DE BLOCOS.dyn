{
  "Uuid": "d3d4bd5c-cb47-4c7e-bf97-d27b640c23cb",
  "IsCustomNode": false,
  "Description": "Insere blocos do AutoCAD de forma automática e em lote nas coordenadas exatas dos pontos do Civil 3D. Otimiza a representação gráfica de levantamentos (árvores, infraestrutura, etc.). Pré-requisito: O bloco a ser utilizado deve estar previamente inserido/carregado no DWG ativo. Configurações parametrizáveis conforme a necessidade do projeto.",
  "Name": "INSERÇÃO DE BLOCOS",
  "ElementResolver": {
    "ResolutionMap": {
      "Autodesk.Object": {
        "Key": "Autodesk.AutoCAD.DynamoNodes.Object",
        "Value": "AutoCADNodes.dll"
      }
    }
  },
