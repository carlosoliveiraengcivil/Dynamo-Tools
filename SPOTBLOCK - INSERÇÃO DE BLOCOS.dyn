  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CIVIL 3D NEXUS - AUTOMATION\r\n# Engine: CPython 3 (V 2.2 - Smart Eyedropper + CPython Safe)\r\n\r\nimport sys\r\nimport clr\r\nimport math\r\n\r\nclr.AddReference('acmgd')\r\nclr.AddReference('acdbmgd')\r\nfrom Autodesk.AutoCAD.ApplicationServices import *\r\nfrom Autodesk.AutoCAD.DatabaseServices import *\r\nfrom Autodesk.AutoCAD.Geometry import *\r\n\r\n# -------------------------------------------------------------\r\n# FUNCAO: Desempacotar Listas do Dynamo\r\n# -------------------------------------------------------------\r\ndef achatar_lista(raw_input):\r\n    if isinstance(raw_input, list):\r\n        res = []\r\n        for item in raw_input:\r\n            res.extend(achatar_lista(item))\r\n        return res\r\n    return [raw_input]\r\n\r\n# -------------------------------------------------------------\r\n# INPUTS\r\n# -------------------------------------------------------------\r\nraw_samples = IN[0]\r\nsample_objs = achatar_lista(raw_samples)\r\n\r\nblock_name = str(IN[1]).strip()\r\nscale_val = float(IN[2]) if IN[2] is not None else 1.0\r\nrot_deg = float(IN[3]) if IN[3] is not None else 0.0\r\n\r\nadoc = Application.DocumentManager.MdiActiveDocument\r\ndb = adoc.Database\r\n\r\ndef get_original_block_layer(btr, t, b_name):\r\n    for obj_id in btr:\r\n        ent = t.GetObject(obj_id, OpenMode.ForRead)\r\n        if isinstance(ent, BlockReference):\r\n            try:\r\n                if ent.Name.upper() == b_name.upper():\r\n                    return ent.Layer\r\n            except:\r\n                pass\r\n    return None\r\n\r\n# -------------------------------------------------------------\r\n# TRANSACAO PRINCIPAL\r\n# -------------------------------------------------------------\r\ndoclock = adoc.LockDocument()\r\nt = db.TransactionManager.StartTransaction()\r\n\r\ntry:\r\n    # 1. Extrai Layers das Amostras\r\n    target_layers = set()\r\n    for obj in sample_objs:\r\n        if obj is not None and hasattr(obj, 'InternalObjectId'):\r\n            ent = t.GetObject(obj.InternalObjectId, OpenMode.ForRead)\r\n            target_layers.add(ent.Layer.strip().upper())\r\n            \r\n    if not target_layers:\r\n        raise ValueError(\"O Script nao conseguiu extrair nenhum layer da sua selecao.\")\r\n\r\n    # 2. Acesso Seguro ao ModelSpace (Sem colchetes)\r\n    msId = SymbolUtilityServices.GetBlockModelSpaceId(db)\r\n    ms = t.GetObject(msId, OpenMode.ForWrite)\r\n    \r\n    # 3. Acesso Seguro a Tabela de Blocos (Sem colchetes)\r\n    bt = t.GetObject(db.BlockTableId, OpenMode.ForRead)\r\n    if not bt.Has(block_name):\r\n        raise ValueError(\"O bloco '{}' nao existe neste arquivo.\".format(block_name))\r\n    \r\n    # Busca a ID do bloco varrendo a tabela (A prova de bugs do Dynamo)\r\n    block_def_id = None\r\n    for b_id in bt:\r\n        b_rec = t.GetObject(b_id, OpenMode.ForRead)\r\n        if b_rec.Name.upper() == block_name.upper():\r\n            block_def_id = b_id\r\n            break\r\n            \r\n    if block_def_id is None:\r\n        raise ValueError(\"Falha ao carregar a definicao do bloco.\")\r\n\r\n    target_block_layer = get_original_block_layer(ms, t, block_name)\r\n    layer_destino = target_block_layer if target_block_layer else \"Layer Atual (Nao achou original)\"\r\n    \r\n    # 4. Varre o Model Space buscando os pontos\r\n    pts_to_insert = []\r\n    \r\n    for obj_id in ms:\r\n        ent = t.GetObject(obj_id, OpenMode.ForRead)\r\n        if isinstance(ent, DBPoint):\r\n            if ent.Layer.strip().upper() in target_layers:\r\n                pts_to_insert.append(ent.Position)\r\n    \r\n    if not pts_to_insert:\r\n        raise ValueError(\"Layers lidos: {}. \\nNenhum Ponto encontrado nesses layers específicos.\".format(\", \".join(target_layers)))\r\n\r\n    # 5. Cria e Insere os Blocos\r\n    blocos_inseridos = 0\r\n    rot_rad = math.radians(rot_deg)\r\n    scale_3d = Scale3d(scale_val)\r\n    \r\n    for pt in pts_to_insert:\r\n        br = BlockReference(pt, block_def_id)\r\n        br.ScaleFactors = scale_3d\r\n        br.Rotation = rot_rad\r\n        \r\n        if target_block_layer:\r\n            br.Layer = target_block_layer\r\n            \r\n        ms.AppendEntity(br)\r\n        t.AddNewlyCreatedDBObject(br, True)\r\n        blocos_inseridos += 1\r\n\r\n    t.Commit()\r\n    OUT = \"SUCESSO!\\nLayers lidos: {}\\nBlocos '{}' inseridos: {}\\nLayer de Destino: {}\".format(\r\n        \", \".join(target_layers), block_name, blocos_inseridos, layer_destino)\r\n\r\nexcept Exception as ex:\r\n    if 't' in locals(): t.Abort()\r\n    OUT = \"DIAGNOSTICO:\\n\" + str(ex)\r\nfinally:\r\n    if 't' in locals(): t.Dispose()\r\n    doclock.Dispose()",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "d40278feb8e4499cb01dfaf4df1562cb",
      "NodeType": "PythonScriptNode",
