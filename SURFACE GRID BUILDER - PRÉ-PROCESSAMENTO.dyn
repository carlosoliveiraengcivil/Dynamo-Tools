      "Description": "Produces numeric values",
      "InputValue": 0.5
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CIVIL 3D NEXUS - AUTOMATION\r\n# TOOL 01: Surface Grid Resampler (O \"Alisador\" de Drone) - V 1.1 (Correção Extents)\r\n\r\nimport sys\r\nimport clr\r\nimport time\r\n\r\nclr.AddReference('acmgd')\r\nclr.AddReference('acdbmgd')\r\nclr.AddReference('AeccDbMgd')\r\n\r\nfrom Autodesk.AutoCAD.ApplicationServices import *\r\nfrom Autodesk.AutoCAD.DatabaseServices import *\r\nfrom Autodesk.AutoCAD.Geometry import *\r\nfrom Autodesk.Civil.DatabaseServices import *\r\n\r\n# -------------------------------------------------------------\r\n# INPUTS\r\n# -------------------------------------------------------------\r\nsurf_input = IN[0]\r\n\r\ntry: grid_size = float(IN[1])\r\nexcept: grid_size = 1.0 # Tamanho da malha padrao (1 metro)\r\n\r\nadoc = Application.DocumentManager.MdiActiveDocument\r\ndb = adoc.Database\r\n\r\n# -------------------------------------------------------------\r\n# TRANSACAO PRINCIPAL\r\n# -------------------------------------------------------------\r\ndoclock = adoc.LockDocument()\r\nt = db.TransactionManager.StartTransaction()\r\n\r\ntry:\r\n    if not hasattr(surf_input, 'InternalObjectId'):\r\n        raise ValueError(\"Selecione uma TIN Surface valida do Civil 3D.\")\r\n        \r\n    orig_surf = t.GetObject(surf_input.InternalObjectId, OpenMode.ForRead)\r\n    \r\n    # CORREÇÃO: Pega os limites (Bounding Box) da superfície usando a API nativa\r\n    extents = orig_surf.GeometricExtents\r\n    min_pt = extents.MinPoint\r\n    max_pt = extents.MaxPoint\r\n    \r\n    min_x, min_y = min_pt.X, min_pt.Y\r\n    max_x, max_y = max_pt.X, max_pt.Y\r\n    \r\n    pts_collection = Point3dCollection()\r\n    \r\n    # Cria o Grid e fura a superficie original para descobrir o Z\r\n    curr_x = min_x\r\n    while curr_x <= max_x:\r\n        curr_y = min_y\r\n        while curr_y <= max_y:\r\n            try:\r\n                # Se o XY cair dentro da superficie, ele acha o Z.\r\n                z = orig_surf.FindElevationAtXY(curr_x, curr_y)\r\n                pts_collection.Add(Point3d(curr_x, curr_y, z))\r\n            except:\r\n                pass # Ponto caiu fora da borda da malha, ignora.\r\n            \r\n            curr_y += grid_size\r\n        curr_x += grid_size\r\n\r\n    # Cria a NOVA superficie no Civil 3D\r\n    surf_name = \"SURFACE_GRID_{}m_{}\".format(grid_size, int(time.time()))\r\n    new_surf_id = TinSurface.Create(db, surf_name)\r\n    new_surf = t.GetObject(new_surf_id, OpenMode.ForWrite)\r\n    \r\n    # Adiciona os pontos amostrados nela\r\n    new_surf.AddVertices(pts_collection)\r\n\r\n    t.Commit()\r\n    \r\n    OUT = \"###RESUMO DA MALHA GERADA ###\\n\\n\"\r\n    OUT += \"Grid Utilizado: {} x {} metros\\n\".format(grid_size, grid_size)\r\n    OUT += \"Nova Superficie Criada: {}\\n\".format(surf_name)\r\n    OUT += \"Total de Pontos Gerados: {}\\n\".format(pts_collection.Count)\r\n    OUT += \"\\n->Faça a verificação da malha gerada.\"\r\n\r\nexcept Exception as ex:\r\n    if 't' in locals(): t.Abort()\r\n    import traceback\r\n    OUT = \"ERRO:\\n\" + traceback.format_exc()\r\nfinally:\r\n    if 't' in locals(): t.Dispose()\r\n    doclock.Dispose()",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "df7ca90b7fd24705b2a8e49ad5c2b735",
      "NodeType": "PythonScriptNode",
