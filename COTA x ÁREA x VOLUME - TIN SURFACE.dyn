{
  "Uuid": "f9dde39b-c9dc-46a5-ad96-d5e56e51587f",
  "IsCustomNode": false,
  "Description": "Automação para fatiamento e cubagem de Superfícies TIN no Civil 3D. A ferramenta processa topografias de alta complexidade (múltiplos picos, depressões, ilhas e formas irregulares) com precisão. Utilizando o rigoroso método das Áreas Médias (Average End Area) entre planos de elevação, o script fatia o modelo digital em intervalos customizáveis, entregando relatórios instantâneos de área, volume incremental e volume acumulado. Ideal para curvas cota-volume de reservatórios, medição de bancadas de cava e cubagem de pilhas de minério.",
  "Name": "COTA x ÁREA x VOLUME - TIN SURFACE",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "ab78c860dcf44f86a7cf2b4abcd2c069",
      "Name": "1. SELECIONE A SUPERFÍCIE",
      "Type": "selection",
      "Type2": "hostSelection",
      "Value": "B94C",
      "Description": "Select an object in the current document"
    },
    {
      "Id": "05dee83500c74f088c302224fcbab844",
      "Name": "3. ESPAÇAMENTO (opcional)",
      "Type": "number",
      "Type2": "number",
      "Value": "0",
      "MaximumValue": 100.0,
      "MinimumValue": 0.0,
      "StepValue": 0.1,
      "NumberType": "Double",
      "Description": "Produces numeric values"
    },
    {
      "Id": "281819445d29430590799a2df162fd1a",
      "Name": "5. PONTO DE INSERÇÃO DA TABELA",
      "Type": "selection",
      "Type2": "hostSelection",
      "Value": "621241.5676966476;7770370.9921411835;0",
      "Description": "Select a point in the current document"
    },
    {
      "Id": "d44b6f1d0e6943e98036d3e01f712056",
      "Name": "2. ELEVAÇÃO MÁXIMA PARA O CÁLCULO",
      "Type": "number",
      "Type2": "number",
      "Value": "0",
      "NumberType": "Double",
      "Description": "Creates a number"
    }
  ],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CIVIL 3D NEXUS - TABLE GENERATOR V10.1 (SÓLIDO ESCAVADO / TOLERÂNCIA ZERO)\r\nimport sys\r\nimport clr\r\n\r\n# Referências\r\nclr.AddReference('AcMgd')\r\nclr.AddReference('AcDbMgd')\r\nclr.AddReference('AeccDbMgd')\r\nclr.AddReference('ProtoGeometry')\r\n\r\nimport Autodesk.AutoCAD.DatabaseServices as AcDb\r\nimport Autodesk.Civil.DatabaseServices as CivDb\r\nfrom Autodesk.AutoCAD.ApplicationServices import Application\r\nfrom Autodesk.AutoCAD.Geometry import Point3d\r\n\r\n# --- INPUTS ---\r\nsurf_input = IN[0]\r\nuser_max_input = IN[1]       # Cota Máxima (Opcional, 0 = Automático)\r\nstep_input = IN[2]           # Espaçamento (Opcional, 0 = Automático)\r\ninsert_pt_dynamo = IN[3]     # Ponto de Inserção\r\n\r\nadoc = Application.DocumentManager.MdiActiveDocument\r\n\r\ndef to_br(val):\r\n    \"\"\"Formatação PT-BR\"\"\"\r\n    if val is None: return \"0,000\"\r\n    s = \"{:,.3f}\".format(val)\r\n    return s.replace(',', 'X').replace('.', ',').replace('X', '.')\r\n\r\ndef pt_key(p):\r\n    \"\"\"Gera chave única para o vértice para o rastreamento da borda\"\"\"\r\n    return \"{:.6f},{:.6f},{:.6f}\".format(p.X, p.Y, p.Z)\r\n\r\ndef calculate_prism_properties(triangles_list, z):\r\n    \"\"\"Integra a área e o volume de uma lista de triângulos 3D abaixo de um plano Z\"\"\"\r\n    total_area = 0.0\r\n    total_vol = 0.0\r\n    for A, z1, z2, z3 in triangles_list:\r\n        if z <= z1:\r\n            continue\r\n        elif z >= z3:\r\n            total_area += A\r\n            total_vol += A * (z - (z1 + z2 + z3) / 3.0)\r\n        else:\r\n            D1 = z2 - z1\r\n            D2 = z3 - z1\r\n            D3 = z3 - z2\r\n            if z <= z2:\r\n                total_area += A * ((z - z1)**2) / (D1 * D2)\r\n                total_vol += A * ((z - z1)**3) / (3.0 * D1 * D2)\r\n            else:\r\n                term1 = (z3 - z)**2 / (D2 * D3)\r\n                total_area += A * (1.0 - term1)\r\n                \r\n                v_z2 = A * (D1**2) / (3.0 * D2)\r\n                v_z = v_z2 + A * (z - z2) + A * ((z3 - z)**3) / (3.0 * D2 * D3) - A * (D3**2) / (3.0 * D2)\r\n                total_vol += v_z\r\n    return total_area, total_vol\r\n\r\ndef create_acad_table_v10_1():\r\n    if insert_pt_dynamo is None: return \"Erro: Ponto de inserção vazio.\"\r\n    \r\n    ins_pt = Point3d(insert_pt_dynamo.X, insert_pt_dynamo.Y, 0)\r\n    \r\n    lock = adoc.LockDocument()\r\n    try:\r\n        t = adoc.Database.TransactionManager.StartTransaction()\r\n        try:\r\n            # --- 1. Validação ---\r\n            try:\r\n                baseId = surf_input.InternalObjectId\r\n                surf = t.GetObject(baseId, AcDb.OpenMode.ForRead)\r\n            except:\r\n                t.Abort()\r\n                return \"Erro: Superfície inválida.\"\r\n\r\n            if not isinstance(surf, CivDb.TinSurface):\r\n                t.Abort()\r\n                return \"Erro: Objeto não é TinSurface.\"\r\n\r\n            # --- 2. Extração da Geometria (Triângulos e Borda) ---\r\n            sump_triangles_data = []\r\n            edges_dict = {}\r\n            \r\n            for tri in surf.GetTriangles(False):\r\n                p1 = tri.Vertex1.Location\r\n                p2 = tri.Vertex2.Location\r\n                p3 = tri.Vertex3.Location\r\n                k1, k2, k3 = pt_key(p1), pt_key(p2), pt_key(p3)\r\n                \r\n                A = abs(0.5 * (p1.X * (p2.Y - p3.Y) + p2.X * (p3.Y - p1.Y) + p3.X * (p1.Y - p2.Y)))\r\n                if A > 0.000001:\r\n                    z_coords = sorted([p1.Z, p2.Z, p3.Z])\r\n                    sump_triangles_data.append((A, z_coords[0], z_coords[1], z_coords[2]))\r\n                \r\n                for u_key, v_key, u_pt, v_pt in [(k1, k2, p1, p2), (k2, k3, p2, p3), (k3, k1, p3, p1)]:\r\n                    if (v_key, u_key) in edges_dict:\r\n                        del edges_dict[(v_key, u_key)]\r\n                    else:\r\n                        edges_dict[(u_key, v_key)] = (u_pt, v_pt)\r\n\r\n            # --- 3. Construção da \"Tampa Inclinada\" Virtual ---\r\n            unique_pts = {}\r\n            for u_pt, v_pt in edges_dict.values():\r\n                unique_pts[pt_key(u_pt)] = u_pt\r\n                unique_pts[pt_key(v_pt)] = v_pt\r\n            \r\n            sum_x = sum_y = sum_z = 0.0\r\n            for pt in unique_pts.values():\r\n                sum_x += pt.X\r\n                sum_y += pt.Y\r\n                sum_z += pt.Z\r\n            n = len(unique_pts)\r\n            if n > 0:\r\n                R = Point3d(sum_x/n, sum_y/n, sum_z/n)\r\n            else:\r\n                t.Abort()\r\n                return \"Erro: Superfície sem bordas válidas.\"\r\n                \r\n            lid_triangles_data = []\r\n            total_lid_area = 0.0\r\n            \r\n            for u_pt, v_pt in edges_dict.values():\r\n                A_signed = 0.5 * (u_pt.X * (v_pt.Y - R.Y) + v_pt.X * (R.Y - u_pt.Y) + R.X * (u_pt.Y - v_pt.Y))\r\n                total_lid_area += A_signed\r\n                \r\n            sign_mult = 1.0 if total_lid_area >= 0 else -1.0\r\n            \r\n            for u_pt, v_pt in edges_dict.values():\r\n                A_signed = 0.5 * (u_pt.X * (v_pt.Y - R.Y) + v_pt.X * (R.Y - u_pt.Y) + R.X * (u_pt.Y - v_pt.Y))\r\n                A = A_signed * sign_mult\r\n                if abs(A) > 1e-9:\r\n                    z_coords = sorted([u_pt.Z, v_pt.Z, R.Z])\r\n                    lid_triangles_data.append((A, z_coords[0], z_coords[1], z_coords[2]))\r\n\r\n            props = surf.GetGeneralProperties()\r\n            real_min = props.MinimumElevation\r\n            real_max = props.MaximumElevation\r\n            \r\n            # --- 4. Inputs Opcionais (Tolerância Extrema) ---\r\n            target_max = real_max # Padrão: vai até o bico da crista\r\n            try:\r\n                if user_max_input is not None and str(user_max_input).strip() != \"\":\r\n                    val = float(user_max_input)\r\n                    # Se o valor digitado (ex: 0) for menor que o fundo, ignora e usa a tampa real\r\n                    if val > real_min:\r\n                        target_max = val\r\n            except:\r\n                pass\r\n\r\n            z_list = []\r\n            has_step = False\r\n            try:\r\n                if step_input is not None and str(step_input).strip() != \"\":\r\n                    step_val = float(step_input)\r\n                    # Só faz fatiamento se o step for maior que zero\r\n                    if step_val > 0:\r\n                        has_step = True\r\n                        current_z = real_min\r\n                        while current_z < target_max - 0.001:\r\n                            z_list.append(current_z)\r\n                            current_z += step_val\r\n                        z_list.append(target_max)\r\n            except:\r\n                pass\r\n                \r\n            if not has_step:\r\n                z_list = [real_min, target_max]\r\n\r\n            # --- 5. Cálculo Iterativo do Sólido ---\r\n            data_rows = []\r\n            prev_accum_vol = 0.0\r\n            \r\n            for z in z_list:\r\n                sump_area, sump_vol = calculate_prism_properties(sump_triangles_data, z)\r\n                lid_area, lid_vol = calculate_prism_properties(lid_triangles_data, z)\r\n                \r\n                solid_area = sump_area - lid_area\r\n                solid_vol = sump_vol - lid_vol\r\n                \r\n                if solid_area < 0.0001: solid_area = 0.0\r\n                \r\n                vol_inc = solid_vol - prev_accum_vol\r\n                if vol_inc < 0.0001: vol_inc = 0.0\r\n                \r\n                data_rows.append([\r\n                    to_br(z),\r\n                    to_br(solid_area),\r\n                    to_br(vol_inc),\r\n                    to_br(solid_vol)\r\n                ])\r\n                prev_accum_vol = solid_vol\r\n\r\n            # --- 6. Geração da Tabela no AutoCAD ---\r\n            msId = AcDb.SymbolUtilityServices.GetBlockModelSpaceId(adoc.Database)\r\n            btr = t.GetObject(msId, AcDb.OpenMode.ForWrite)\r\n            \r\n            table = AcDb.Table()\r\n            table.SetDatabaseDefaults()\r\n            \r\n            num_rows = len(data_rows) + 2\r\n            table.SetSize(num_rows, 4)\r\n            table.Position = ins_pt\r\n            table.SetColumnWidth(35)\r\n            table.SetRowHeight(8)\r\n            \r\n            if has_step:\r\n                table.SetTextString(0, 0, \"MEMÓRIA DE CÁLCULO - SÓLIDO ESCAVADO (COTA x ÁREA x VOL)\")\r\n            else:\r\n                table.SetTextString(0, 0, \"MEMÓRIA DE CÁLCULO - VOLUME TOTAL DO SÓLIDO\")\r\n                \r\n            headers = [\"COTA (m)\", \"ÁREA DA SEÇÃO (m²)\", \"VOLUME PARCIAL (m³)\", \"VOL. ACUMULADO (m³)\"]\r\n            for c in range(4): table.SetTextString(1, c, headers[c])\r\n            \r\n            for i, row in enumerate(data_rows):\r\n                idx = i + 2\r\n                if idx < num_rows:\r\n                    for c in range(4): table.SetTextString(idx, c, row[c])\r\n            \r\n            btr.AppendEntity(table)\r\n            t.AddNewlyCreatedDBObject(table, True)\r\n            \r\n            t.Commit()\r\n            return \"Sucesso: Tabela Sólido Escavado V10.1 Gerada.\"\r\n            \r\n        except Exception as e:\r\n            t.Abort()\r\n            import traceback\r\n            return \"Erro Interno: \" + str(e) + \"\\n\" + traceback.format_exc()\r\n        finally:\r\n            t.Dispose()\r\n            \r\n    except Exception as e_lock:\r\n        return \"Erro Lock: \" + str(e_lock)\r\n    finally:\r\n        if lock: lock.Dispose()\r\n\r\nOUT = create_acad_table_v10_1()",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "cc779ee72a3f42eb9c6d7f4c25084226",
